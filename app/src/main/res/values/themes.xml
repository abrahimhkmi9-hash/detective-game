<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DetectiveGame" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold_accent</item>
        <item name="colorPrimaryVariant">@color/gold_light</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>
    <style name="BtnGold" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="BtnRed" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/red_accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="BtnOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/gold_accent</item>
        <item name="android:textColor">@color/gold_accent</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
