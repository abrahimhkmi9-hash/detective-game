<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="24dp">
        <TextView android:id="@+id/ivResultIcon" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="🔍" android:textSize="64sp"/>
        <TextView android:id="@+id/tvResult" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="26sp"
            android:textStyle="bold" android:textColor="@color/gold_accent"
            android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/tvSuspectAccused" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/text_primary" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvStars" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="32sp"
            android:textColor="@color/gold_accent" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/bg_card"
            android:padding="16dp" android:layout_marginTop="16dp">
            <TextView android:id="@+id/tvTime" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvEvidence" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textColor="@color/text_secondary" android:layout_marginTop="4dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border_color" android:layout_marginVertical="10dp"/>
            <TextView android:id="@+id/tvSolution" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textColor="@color/text_primary" android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>
        <Button android:id="@+id/btnNextCase" style="@style/BtnGold"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="القضية التالية" android:layout_marginTop="20dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnReplay" style="@style/BtnOutline"
                android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:text="إعادة اللعب"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnHome" style="@style/BtnOutline"
                android:layout_width="0dp" android:layout_height="46dp"
                android:layout_weight="1" android:text="الرئيسية"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
