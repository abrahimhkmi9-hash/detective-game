<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="@color/bg_card">
        <Button android:id="@+id/btnBack" style="@style/BtnOutline"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="→" android:paddingHorizontal="12dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="اختر القضية"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/gold_accent" android:gravity="center"/>
        <View android:layout_width="48dp" android:layout_height="36dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCases"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
</LinearLayout>
