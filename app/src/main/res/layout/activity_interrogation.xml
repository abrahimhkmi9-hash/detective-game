<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="@color/bg_card">
        <Button android:id="@+id/btnBack" style="@style/BtnOutline"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="→" android:paddingHorizontal="12dp"/>
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/gold_accent" android:gravity="center"/>
        <View android:layout_width="48dp" android:layout_height="36dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSuspects"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:clipToPadding="false"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical"
        android:background="@color/bg_card" android:padding="16dp"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvSuspectName" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/gold_accent"/>
            <TextView android:id="@+id/contradictionIndicator" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="⚠️ كذب مكتشف"
                android:textSize="12sp" android:textColor="@color/red_light"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView android:id="@+id/tvSuspectRole" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border_color" android:layout_marginVertical="12dp"/>
        <TextView android:id="@+id/tvStatement" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:textSize="15sp"
            android:textColor="@color/text_primary" android:lineSpacingMultiplier="1.5"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="12dp"
        android:paddingBottom="12dp" android:gravity="center">
        <Button android:id="@+id/btnAsk" style="@style/BtnOutline"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="اسأل" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnConfront" style="@style/BtnOutline"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="واجه" android:layout_marginEnd="6dp"/>
        <Button android:id="@+id/btnAccuse" style="@style/BtnRed"
            android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:text="اتهم"/>
    </LinearLayout>
</LinearLayout>
