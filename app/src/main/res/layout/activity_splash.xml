<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@color/bg_dark" android:layoutDirection="rtl">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🔍" android:textSize="80sp" android:layout_marginBottom="16dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="محقق الجرائم" android:textSize="32sp" android:textStyle="bold"
        android:textColor="@color/gold_accent"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="ملفات جنائية" android:textSize="14sp"
        android:textColor="@color/text_secondary" android:layout_marginTop="4dp"/>
    <ProgressBar android:layout_width="120dp" android:layout_height="wrap_content"
        android:layout_marginTop="48dp" android:indeterminateTint="@color/gold_accent"/>
</LinearLayout>
