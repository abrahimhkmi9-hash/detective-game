<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:layout_marginBottom="6dp"
    android:background="@color/bg_card2" android:layoutDirection="rtl">
    <TextView android:id="@+id/tvContradictionBadge" android:layout_width="28dp"
        android:layout_height="28dp" android:text="⚠" android:textSize="16sp"
        android:gravity="center" android:textColor="@color/red_light" android:visibility="gone"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="8dp">
        <TextView android:id="@+id/tvSuspectName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/text_primary"/>
        <TextView android:id="@+id/tvSuspectRole" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/text_secondary"/>
    </LinearLayout>
</LinearLayout>
