<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:background="@color/bg_card">
        <Button android:id="@+id/btnBack" style="@style/BtnOutline"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="→" android:paddingHorizontal="12dp"/>
        <TextView android:id="@+id/tvCaseTitle" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/gold_accent" android:gravity="center"/>
        <TextView android:id="@+id/tvTimer" android:layout_width="70dp"
            android:layout_height="wrap_content" android:text="15:00"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/gold_light" android:gravity="end"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="14sp"
                android:textColor="@color/text_primary" android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="الأدلة" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/gold_accent"/>
                <TextView android:id="@+id/tvEvidenceCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEvidence"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="المشتبه بهم" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/gold_accent" android:layout_marginTop="16dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSuspects"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnInterrogate" style="@style/BtnGold"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="انتقل للاستجواب" android:textSize="16sp" android:layout_margin="16dp"/>
</LinearLayout>
